# Kotak Neo (data only - order APIs are never called)
KOTAK_CONSUMER_KEY=
KOTAK_UCC=
KOTAK_MOBILE=+91XXXXXXXXXX
KOTAK_MPIN=
KOTAK_TOTP_SECRET=
KOTAK_ENV=prod

# Data / news
FINNHUB_API_KEY=

# LLM
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_SMART=claude-sonnet-5-5
LLM_MONTHLY_BUDGET_USD=40

# Supabase / Postgres (local default: docker/docker-compose.yml)
# Supabase: postgresql+psycopg://postgres.<ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=postgresql+psycopg://papertrade:papertrade@localhost:5432/papertrade

# Object storage (Oracle or R2, S3-compatible)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Engine API (read-only, used by the dashboard)
ENGINE_API_HOST=0.0.0.0
ENGINE_API_PORT=8000
ENGINE_API_TOKEN=          # long random string; the same value goes in the dashboard's env
DASHBOARD_ORIGINS=https://your-dashboard.vercel.app
STORE_BACKEND=memory       # memory | postgres

# Runtime
APP_MODE=replay        # replay | live_data
TIMEZONE=Asia/Kolkata
CONFIG_DIR=config
LOG_LEVEL=INFO
